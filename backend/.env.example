# 복사해서 backend/.env 로 사용하세요.
# cp .env.example .env

DART_API_KEY=

# Groq (권장 AI 분석)
GROQ_API_KEY=
# 무료 티어는 8B 권장 (70B는 일일 토큰 한도에 빨리 걸림)
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini (코드 유지, 기본 미사용)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (코드 유지, 기본 미사용)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 분석 엔진
#   rule   = 로컬 규칙 기반 분석
#   groq   = Groq API (권장 AI, 실패 시 rule 폴백, 상세 오류는 사용자에게 미노출)
#   gemini = Google Gemini API (유지용)
#   openai = OpenAI API (유지용, 비권장)
ANALYSIS_PROVIDER=groq

# 추천 테마(B3) — 현재는 시드+규칙. 아래 키는 향후 연동용(미사용)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# KRX_API_KEY=
